<gui version="0.2" name="Profile">
  <tokens>
    <color name="bg" value="#F2F2F7" />
    <color name="surface" value="#FFFFFF" />
    <color name="text-primary" value="#1C1C1E" />
    <color name="text-secondary" value="#6E6E73" />
    <color name="text-tertiary" value="#AEAEB2" />
    <color name="border" value="#E5E5EA" />
    <color name="primary" value="#007AFF" />
    <color name="accent" value="#FF9500" />
    <number name="radius-card" value="14" />
    <number name="radius-pill" value="999" />
    <number name="space-xs" value="4" />
    <number name="space-sm" value="8" />
    <number name="space-md" value="12" />
    <number name="space-lg" value="16" />
    <number name="space-xl" value="24" />
  </tokens>

  <styles>
    <text-style name="LargeTitle" font-family="SF Pro" font-size="34" font-weight="700" line-height="41" />
    <text-style name="Headline" font-family="SF Pro" font-size="17" font-weight="600" line-height="22" />
    <text-style name="Body" font-family="SF Pro" font-size="17" font-weight="400" line-height="22" />
    <text-style name="Subheadline" font-family="SF Pro" font-size="15" font-weight="400" line-height="20" />
    <text-style name="Footnote" font-family="SF Pro" font-size="13" font-weight="400" line-height="18" />
    <text-style name="Caption" font-family="SF Pro" font-size="12" font-weight="500" line-height="16" letter-spacing="0.4" />
  </styles>

  <fonts>
    <font family="SF Pro" source="system" weights="400 500 600 700" styles="normal" />
    <font family="Inter" source="google" weights="400 500 600 700" styles="normal" />
  </fonts>

  <col w="390" fill="$bg">
    <!-- Status bar + nav area spacer -->
    <col h="91" />

    <!-- Large title -->
    <col p="12 20 16 20">
      <row align="middle-left">
        <text text-style="LargeTitle" value="Profile" color="$text-primary" />
        <col w="fill" />
        <row w="36" h="36" radius="$radius-pill" fill="$surface" align="middle-center">
          <img src="https://api.iconify.design/lucide/more-vertical.svg?color=%231C1C1E" w="20" h="20" />
        </row>
      </row>
    </col>

    <!-- Profile header card -->
    <col p="0 16" gap="$space-lg">
      <col fill="$surface" radius="$radius-card" p="$space-xl">
        <row gap="$space-lg" align="middle-left">
          <row w="72" h="72" radius="36" fill="linear-gradient(135deg, #FF9500 0%, #FF2D55 100%)" align="middle-center">
            <text value="MR" font-family="SF Pro" font-size="26" font-weight="700" color="#FFFFFF" />
          </row>
          <col gap="$space-xs">
            <text text-style="Headline" value="Maya Reyes" color="$text-primary" font-size="22" line-height="28" />
            <text text-style="Subheadline" value="Product Designer, Stripe" color="$text-secondary" />
            <row gap="$space-sm" align="middle-left">
              <row w="6" h="6" radius="3" fill="#34C759" />
              <text text-style="Footnote" value="Active now" color="$text-secondary" />
            </row>
          </col>
        </row>
      </col>

      <!-- Stats row -->
      <row gap="$space-md">
        <col w="fill" fill="$surface" radius="$radius-card" p="$space-lg" gap="$space-xs" align="top-center">
          <text value="1,284" font-family="SF Pro" font-size="22" font-weight="700" color="$text-primary" line-height="28" />
          <text text-style="Caption" value="FOLLOWERS" color="$text-secondary" />
        </col>
        <col w="fill" fill="$surface" radius="$radius-card" p="$space-lg" gap="$space-xs" align="top-center">
          <text value="312" font-family="SF Pro" font-size="22" font-weight="700" color="$text-primary" line-height="28" />
          <text text-style="Caption" value="FOLLOWING" color="$text-secondary" />
        </col>
        <col w="fill" fill="$surface" radius="$radius-card" p="$space-lg" gap="$space-xs" align="top-center">
          <text value="48" font-family="SF Pro" font-size="22" font-weight="700" color="$text-primary" line-height="28" />
          <text text-style="Caption" value="PROJECTS" color="$text-secondary" />
        </col>
      </row>

      <!-- Settings list (grouped card with internal dividers) -->
      <col gap="$space-sm">
        <text text-style="Caption" value="ACCOUNT" color="$text-secondary" p="0 4" />
        <col fill="$surface" radius="$radius-card">
          <row p="14 16" align="middle-left" gap="$space-md">
            <row w="28" h="28" radius="6" fill="$primary" align="middle-center">
              <img src="https://api.iconify.design/lucide/user.svg?color=%23FFFFFF" w="16" h="16" />
            </row>
            <text text-style="Body" value="Personal Information" color="$text-primary" />
            <col w="fill" />
            <text text-style="Body" value="Verified" color="$text-tertiary" />
            <img src="https://api.iconify.design/lucide/chevron-right.svg?color=%23C7C7CC" w="8" h="14" />
          </row>
          <row h="1" fill="$border" p="0 16" />
          <row p="14 16" align="middle-left" gap="$space-md">
            <row w="28" h="28" radius="6" fill="#FF9500" align="middle-center">
              <img src="https://api.iconify.design/lucide/credit-card.svg?color=%23FFFFFF" w="16" h="16" />
            </row>
            <text text-style="Body" value="Subscription" color="$text-primary" />
            <col w="fill" />
            <text text-style="Body" value="Pro" color="$text-tertiary" />
            <img src="https://api.iconify.design/lucide/chevron-right.svg?color=%23C7C7CC" w="8" h="14" />
          </row>
          <row h="1" fill="$border" p="0 16" />
          <row p="14 16" align="middle-left" gap="$space-md">
            <row w="28" h="28" radius="6" fill="#5856D6" align="middle-center">
              <img src="https://api.iconify.design/lucide/grid.svg?color=%23FFFFFF" w="16" h="16" />
            </row>
            <text text-style="Body" value="Workspaces" color="$text-primary" />
            <col w="fill" />
            <text text-style="Body" value="4" color="$text-tertiary" />
            <img src="https://api.iconify.design/lucide/chevron-right.svg?color=%23C7C7CC" w="8" h="14" />
          </row>
        </col>

        <col h="$space-lg" />

        <text text-style="Caption" value="PREFERENCES" color="$text-secondary" p="0 4" />
        <col fill="$surface" radius="$radius-card">
          <row p="14 16" align="middle-left" gap="$space-md">
            <row w="28" h="28" radius="6" fill="#34C759" align="middle-center">
              <img src="https://api.iconify.design/lucide/bell.svg?color=%23FFFFFF" w="16" h="16" />
            </row>
            <text text-style="Body" value="Notifications" color="$text-primary" />
            <col w="fill" />
            <img src="https://api.iconify.design/lucide/chevron-right.svg?color=%23C7C7CC" w="8" h="14" />
          </row>
          <row h="1" fill="$border" p="0 16" />
          <row p="14 16" align="middle-left" gap="$space-md">
            <row w="28" h="28" radius="6" fill="#FF2D55" align="middle-center">
              <img src="https://api.iconify.design/lucide/palette.svg?color=%23FFFFFF" w="16" h="16" />
            </row>
            <text text-style="Body" value="Appearance" color="$text-primary" />
            <col w="fill" />
            <text text-style="Body" value="Auto" color="$text-tertiary" />
            <img src="https://api.iconify.design/lucide/chevron-right.svg?color=%23C7C7CC" w="8" h="14" />
          </row>
        </col>
      </col>

      <col h="32" />
    </col>
  </col>
</gui>
